<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NxDrawer</RootNamespace>
    <AssemblyName>nx-drawer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- 官方图标与 logo 拷进输出目录，供运行时按配置加载 -->
  <ItemGroup>
    <Content Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 配置模板随包发布：用户解压后直接改 drawer.json 即可，
       不必先跑一次让它自动生成（生成的版本没经过用户校对）。 -->
  <ItemGroup>
    <None Include="drawer.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
